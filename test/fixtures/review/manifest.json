{
  "version": 1,
  "corpus": "ulw-review-plan-corpus",
  "conventions": {
    "caseId": "Lowercase slug, unique per corpus; the caseId is the address of one seed and may not repeat.",
    "stableBlockerId": "blk.<lane>.<eligibility>.<anchor>, where anchor is the single non-empty location field (taskId, isId or gapId); the id is derived, never a free label, so the same defect at the same plan anchor keeps one id across rounds.",
    "evidence": "Paths are repository-relative (the materialized plan target or a declared fixture source), lines are 1-based, and marker is text that must occur on the cited line range; deleting an entry or moving the line breaks validation.",
    "structural": "structural=true means lintPlan enforces the truth with pinned error diagnostics; structural=false means the defect is reviewer-only, lint stays valid, and the expected blocker carries the semantic truth.",
    "notes": "nonBlockingNotes are findings a reviewer may report as notes; they never block and are validated through the real result contract, so an ineligible finding can never masquerade as a blocker."
  },
  "seedCases": 12,
